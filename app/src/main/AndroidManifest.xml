<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediGuard">

        <!-- Splash Screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Register -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Medicine Registration -->
        <activity
            android:name=".MedicineRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Medicine List -->
        <activity
            android:name=".MedicineListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Medicine Details -->
        <activity
            android:name=".MedicineDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- Medication Reminder -->
        <activity
            android:name=".MedicationReminderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Select Medicine -->
        <activity
            android:name=".SelectMedicineActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Set Reminder -->
        <activity
            android:name=".SetReminderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reminder Details (Today's Schedule, Mark as Taken, Missed, ON/OFF) -->
        <activity
            android:name=".ReminderDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reminder Trigger (AlarmManager fires this at dose time) -->
        <receiver
            android:name=".ReminderTriggerReceiver"
            android:exported="false" />

        <!-- Miss-check deadline (AlarmManager fires this if a dose is
             still PENDING MISS_WINDOW_MINUTES after it was triggered) -->
        <receiver
            android:name=".MissCheckReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>