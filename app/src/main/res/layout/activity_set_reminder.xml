<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER ================= -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="@drawable/page_header"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back"
                app:tint="@android:color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="14dp"
                android:text="Set Reminder"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="23sp"/>

        </RelativeLayout>

        <!-- ================= CONTENT ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingBottom="30dp">

            <!-- ================= MEDICINE CARD ================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F1E8F7"
                app:strokeColor="#E2D6EA"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/imgMedicine"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@drawable/ic_pill"
                        android:scaleType="centerCrop"
                        app:tint="#1565F9"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtMedicineName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tempra Paracetamol"
                            android:textColor="#1B2A4E"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtMedicineType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Syrup • 60 mL"
                            android:textColor="#6B7280"
                            android:textSize="14sp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= DOSE PER INTAKE ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Dose per intake"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <!-- DOSE AMOUNT -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutDose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Enter the amount to take each time."
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#B7C3D4"
                    app:hintTextColor="#777777">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="#1B2A4E"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- DOSE UNIT -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutDoseUnit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="Select unit"
                    app:endIconMode="dropdown_menu"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#B7C3D4"
                    app:hintTextColor="#777777">

                    <AutoCompleteTextView
                        android:id="@+id/actDoseUnit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:gravity="center_vertical"
                        android:textColor="#1B2A4E"
                        android:textSize="16sp"
                        android:popupBackground="@drawable/bg_dropdown_popup"
                        android:dropDownVerticalOffset="4dp"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- ================= START DATE ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Start Date"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutStartDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Choose the date to start the reminder."
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#B7C3D4"
                app:hintTextColor="#777777">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStartDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:gravity="center_vertical"
                    android:textColor="#1B2A4E"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ================= START TIME ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Start Time"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutStartTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Choose the time you want to take the medicine."
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_recent_history"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#B7C3D4"
                app:hintTextColor="#777777">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStartTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:gravity="center_vertical"
                    android:textColor="#1B2A4E"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ================= REPEAT EVERY ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Repeat Every"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRepeatEvery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Choose how often the medicine should be taken."
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_recent_history"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#B7C3D4"
                app:hintTextColor="#777777">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/actRepeatEvery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:gravity="center_vertical"
                    android:textColor="#1B2A4E"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ================= DURATION ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Duration"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Choose how long the reminder should run."
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#B7C3D4"
                app:hintTextColor="#777777"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/actDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:gravity="center_vertical"
                    android:textColor="#1B2A4E"
                    android:textSize="16sp"
                    android:popupBackground="@drawable/bg_dropdown_popup"
                    android:dropDownVerticalOffset="4dp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ================= SCHEDULE ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Schedule"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtScheduleInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select the days when you need to take this medicine."
                android:textColor="#777777"
                android:textSize="12sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSameEveryWeek"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Same every week"
                    android:textAllCaps="false"
                    android:textSize="13sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomSchedule"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Custom schedule"
                    android:textAllCaps="false"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- ================= SAME EVERY WEEK ================= -->

            <LinearLayout
                android:id="@+id/sameEveryWeekDaysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Days"
                    android:textColor="#172B4D"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- ROW 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMon"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Mon"
                        android:textAllCaps="false"
                        android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTue"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Tue"
                        android:textAllCaps="false"
                        android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWed"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Wed"
                        android:textAllCaps="false"
                        android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThu"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Thu"
                        android:textAllCaps="false"
                        android:textSize="12sp"/>

                </LinearLayout>

                <!-- ROW 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFri"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Fri"
                        android:textAllCaps="false"
                        android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSat"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Sat"
                        android:textAllCaps="false"
                        android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSun"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Sun"
                        android:textAllCaps="false"
                        android:textSize="12sp"/>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ================= CUSTOM SCHEDULE ================= -->

            <LinearLayout
                android:id="@+id/customScheduleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

            <!-- ================= ADD WEEK ================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddWeek"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="+ Add Week"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#1565F9"
                app:cornerRadius="25dp"
                android:visibility="gone"/>

            <!-- ================= CONTACT NUMBER ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Contact Number"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutContactNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="This defaults to your registered number, but you can change it."
                app:boxBackgroundMode="outline"
                app:startIconDrawable="@android:drawable/ic_menu_call"
                app:boxStrokeColor="#B7C3D4"
                app:hintTextColor="#777777">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:textColor="#1B2A4E"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ================= ENABLE REMINDER ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enable Reminder"
                    android:textColor="#172B4D"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>

            </LinearLayout>

            <!-- ================= SAVE REMINDER ================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveReminder"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:text="Save Reminder"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#1565F9"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                app:iconPadding="10dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>