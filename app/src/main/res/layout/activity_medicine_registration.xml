<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER ================= -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:background="@drawable/page_header"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="15dp"
                android:text="Medicine Registration"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="24sp" />

        </RelativeLayout>


        <!-- ================= CONTENT ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="30dp">


            <!-- ================= PHOTO ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPhoto"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D6E2F2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@android:color/white">

                    <ImageView
                        android:id="@+id/imgPhoto"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:contentDescription="Add Photo"
                        app:tint="#1565F9" />

                    <TextView
                        android:id="@+id/txtPhotoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Add Photo"
                        android:textColor="#1565F9"
                        android:textStyle="bold"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/txtPhotoSubLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Camera or gallery"
                        android:textColor="#666666"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= MEDICINE NAME ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Medicine Name *"
                android:textColor="#172B4D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#B7C3D4"
                app:hintTextColor="#777777">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMedicineName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter medicine name"
                    android:textColor="#1B2A4E"
                    android:textColorHint="#777777"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================= PURPOSE ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Purpose *"
                android:textColor="#172B4D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#B7C3D4"
                app:hintTextColor="#777777">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPurpose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter purpose of this medicine"
                    android:textColor="#1B2A4E"
                    android:textColorHint="#777777"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================= TYPE ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Type *"
                android:textColor="#172B4D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:endIconMode="dropdown_menu"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#B7C3D4"
                app:hintTextColor="#777777">

                <AutoCompleteTextView
                    android:id="@+id/actMedicineType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select type"
                    android:inputType="none"
                    android:focusable="false"
                    android:textColor="#1B2A4E"
                    android:textColorHint="#777777"
                    android:textSize="16sp"
                    android:popupBackground="@drawable/bg_dropdown_popup"
                    android:dropDownVerticalOffset="4dp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================= QUANTITY ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Quantity *"
                android:textColor="#172B4D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:weightSum="5">

                <!-- Quantity -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#B7C3D4">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter quantity"
                        android:inputType="number"
                        android:textColor="#1B2A4E"
                        android:textColorHint="#777777"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>


                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />


                <!-- Unit -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="dropdown_menu"
                    app:boxStrokeColor="#B7C3D4">

                    <AutoCompleteTextView
                        android:id="@+id/actUnit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:inputType="none"
                        android:textColor="#1B2A4E"
                        android:textColorHint="#777777"
                        android:textSize="16sp"
                        android:popupBackground="@drawable/bg_dropdown_popup"
                        android:dropDownVerticalOffset="4dp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!-- ================= EXPIRATION DATE ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Expiration Date *"
                android:textColor="#172B4D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="outline"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                app:boxStrokeColor="#B7C3D4">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExpirationDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select expiration date"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="#1B2A4E"
                    android:textColorHint="#777777"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================= SAVE BUTTON ================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveMedicine"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="24dp"
                android:text="Save Medicine"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#1565F9"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>